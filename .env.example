# External data sources selected in M0. Keep secrets on the backend only.
APP_ENV=development
GIT_SHA=local
USE_SYSTEM_TRUST_STORE=true
DATABASE_URL=sqlite:///./stock_hanaro.db
# Cloudflare Worker server-only Supabase Data API access. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Supabase production example (use the transaction pooler, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
CORS_ORIGINS=http://localhost:3000
INTERNAL_JOB_SECRET=replace-with-a-long-random-value
NEWS_COLLECT_LIMIT=40
NEWS_REQUEST_TIMEOUT_SECONDS=15
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

DART_API_KEY=
DART_PAGE_COUNT=100
DART_MAX_PAGES_PER_MARKET=20
# Cloudflare disclosure page checks OpenDART only when the shared cache is stale (3 minutes during filing hours).
# Add DART_API_KEY as a Cloudflare Worker secret as well as a GitHub Actions secret.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_IS_MOCK=true
# Enable only in production after Supabase migrations are applied.
KIS_ON_DEMAND_REFRESH_ENABLED=false
KIS_US_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,META,AMZN,TSLA,AVGO,AMD,JPM,V,LLY,UNH,XOM,CVX,WMT,COST,HD,GE,CAT
KIS_REQUEST_INTERVAL_SECONDS=0.12
FRED_API_KEY=
# Cloudflare/Supabase deployment uses refresh-based REST quotes, not the WebSocket worker.
KIS_REALTIME_ENABLED=false
KIS_KR_SYMBOLS=005930,000660,005380,373220
KIS_MAX_REALTIME_STOCKS=37
ALLOW_DASHBOARD_FALLBACK=false
BOK_ECOS_API_KEY=
SOLAR_API_KEY=
SOLAR_API_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL=solar-pro3
SOLAR_TIMEOUT_SECONDS=60
